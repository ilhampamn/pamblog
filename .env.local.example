# Site
NEXT_PUBLIC_BASE_URL=https://ilhampamungkas.com

# Uploadthing (SDK v7+)
UPLOADTHING_TOKEN=...

# Keystatic (GitHub OAuth — generate at github.com/settings/apps)
KEYSTATIC_GITHUB_CLIENT_ID=...
KEYSTATIC_GITHUB_CLIENT_SECRET=...
KEYSTATIC_SECRET=...

# Resend (email sending)
RESEND_API_KEY=re_...

# Kit / ConvertKit (newsletter)
KIT_API_KEY=...
KIT_FORM_ID=...

# ── Sanity ──────────────────────────────────────────────────────────────────
# From https://sanity.io/manage. NEXT_PUBLIC_* are safe to expose; tokens are
# server-only — never prefix a token with NEXT_PUBLIC.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only write token used by the migration script (Editor/Developer role).
SANITY_API_WRITE_TOKEN=

# Optional: migrate into a throwaway dataset first (e.g. "staging").
# SANITY_MIGRATION_DATASET=staging

# Shared secret for the /api/revalidate webhook (any long random string).
SANITY_REVALIDATE_SECRET=
