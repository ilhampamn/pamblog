{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client"],
    "paths": {
      "@codapay/config-schema": ["../../packages/config-schema/src/index.ts"],
      "@codapay/tokens": ["../../packages/tokens/src/index.ts"],
      "@codapay/checkout-ui": ["../../packages/checkout-ui/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
